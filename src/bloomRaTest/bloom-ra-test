#!/bin/sh
set -eu

SD_ROOT=${BLOOM_SD_ROOT:-/mnt/SDCARD}
BLOOM_GAME_ID=${BLOOM_GAME_ID_BIN:-$SD_ROOT/.tmp_update/bin/bloom-game-id}
BLOOM_RA=${BLOOM_RA_BIN:-$SD_ROOT/.tmp_update/bin/bloom-ra}
JQ_BIN=${BLOOM_JQ_BIN:-$SD_ROOT/.tmp_update/bin/jq}
BLOOM_GAME_SMOKE=${BLOOM_GAME_SMOKE_BIN:-$SD_ROOT/.tmp_update/bin/bloom-game-smoke}

fail() {
    printf '{"schema":1,"service":"bloom-ra-test","error":{"code":"%s"}}\n' "$1"
    exit 1
}

[ "$#" -eq 6 ] || [ "$#" -eq 8 ] || [ "$#" -eq 10 ] || fail invalid_arguments
[ "$1" = --system ] && [ "$3" = --rom-base64 ] && [ "$5" = --core ] || fail invalid_arguments
[ "$#" -eq 6 ] || [ "$7" = --session-seconds ] || fail invalid_arguments
[ "$#" -ne 10 ] || { [ "$9" = --operator-unlock ] && [ "${10}" = I_ACCEPT_PROFILE_CHANGES ]; } || fail operator_confirmation_required
[ -f "$SD_ROOT/.bloom-dev" ] || fail developer_mode_required
case "$6" in ''|*[!a-z0-9_]*) fail invalid_core ;; esac
case "$2" in
    GB) folder=GB; system=gb; default_core=gambatte ;; GBC) folder=GBC; system=gbc; default_core=gambatte ;;
    GBA) folder=GBA; system=gba; default_core=gpsp ;; FC) folder=FC; system=nes; default_core=fceumm ;;
    SFC) folder=SFC; system=snes; default_core=snes9x ;; PSX) folder=PS; system=psx; default_core=pcsx_rearmed ;;
    SEGASGONE) folder=SEGASGONE; system=sg1000; default_core=genesis_plus_gx ;;
    *) fail unsupported_system ;;
esac

rom=$(printf '%s' "$4" | base64 -d 2>/dev/null) || fail invalid_rom_encoding
case "$rom" in "$SD_ROOT/Roms/$folder/"*) ;; *) fail rom_outside_system ;; esac
[ -f "$rom" ] && [ ! -L "$rom" ] || fail invalid_rom
[ -x "$BLOOM_GAME_ID" ] && [ -x "$BLOOM_RA" ] && [ -x "$JQ_BIN" ] || fail service_unavailable

game_id=$("$BLOOM_GAME_ID" "$system" "$rom" 2>/dev/null) || fail game_id_failed
ra=$("$BLOOM_RA" game "$game_id" 2>/dev/null) || fail identification_failed
identification=$(printf '%s' "$ra" | "$JQ_BIN" -er 'if .status == "identified" and ((.ra.game_id // .ra_game_id // 0) > 0) then "pass" else "unmatched" end' 2>/dev/null) || fail identification_invalid

account=$("$BLOOM_RA" account status 2>/dev/null) || fail account_unavailable
login=$(printf '%s' "$account" | "$JQ_BIN" -er 'if .authenticated == true then "pass" else "attention_required" end' 2>/dev/null) || fail account_invalid

core_file="$SD_ROOT/RetroArch/.retroarch/cores/${6}_libretro.so"
[ -f "$core_file" ] && [ ! -L "$core_file" ] || fail core_not_found
core_sha=$(sha256sum "$core_file" | sed 's/[[:space:]].*//')
policy=$("$BLOOM_RA" cores 2>/dev/null) || fail core_policy_unavailable
core_status=$(printf '%s' "$policy" | "$JQ_BIN" -er --arg system "$system" --arg core "${6}_libretro.so" --arg sha "$core_sha" \
    '[.entries[] | select(.system == $system and .core == $core and .binary_sha256 == $sha) | .bloom_ra_status][0] // "untested"' 2>/dev/null) || fail core_policy_invalid
case "$core_status" in verified|best_effort|incompatible|untested) ;; *) fail core_policy_invalid ;; esac
reported_core="${6}_libretro.so"

session_exit=not_run
save_flush=not_run
rich_presence=not_run
unlock_test=operator_required
operator_session=false
if [ "$#" -ge 8 ]; then
    case "$8" in ''|*[!0-9]*) fail invalid_session_duration ;; esac
    [ "$8" -ge 5 ] && [ "$8" -le 900 ] || fail invalid_session_duration
    [ "$6" = "$default_core" ] || fail session_core_not_default
    [ -x "$BLOOM_GAME_SMOKE" ] || fail session_service_unavailable
    if [ "$#" -eq 10 ]; then
        operator_session=true
        rich_presence=operator_observation_required
        unlock_test=operator_observation_required
        session=$("$BLOOM_GAME_SMOKE" "$2" "$4" "$8" 2>/dev/null) || fail session_failed
    else
        session=$(BLOOM_RA_FORCE_DISABLED=1 "$BLOOM_GAME_SMOKE" "$2" "$4" "$8" 2>/dev/null) || fail session_failed
    fi
    printf '%s' "$session" | "$JQ_BIN" -e '.status == "passed" and .graceful_exit == true and .save_flush == true' >/dev/null 2>&1 || fail session_result_invalid
    reported_core=$(printf '%s' "$session" | "$JQ_BIN" -er '.selected_core') || fail session_result_invalid
    core_sha=$(printf '%s' "$session" | "$JQ_BIN" -er '.selected_core_sha256') || fail session_result_invalid
    case "$reported_core" in *'_libretro.so') ;; *) fail session_result_invalid ;; esac
    case "$core_sha" in ''|*[!0-9a-f]*) fail session_result_invalid ;; esac
    [ "${#core_sha}" -eq 64 ] || fail session_result_invalid
    core_status=$(printf '%s' "$policy" | "$JQ_BIN" -er --arg system "$system" --arg core "$reported_core" --arg sha "$core_sha" \
        '[.entries[] | select(.system == $system and .core == $core and .binary_sha256 == $sha) | .bloom_ra_status][0] // "untested"' 2>/dev/null) || fail core_policy_invalid
    case "$core_status" in verified|best_effort|incompatible|untested) ;; *) fail core_policy_invalid ;; esac
    session_exit=pass
    save_flush=pass
fi

printf '{"schema":1,"service":"bloom-ra-test","device":"host-reported-separately","system":"%s","core":"%s","core_sha256":"%s","bloom_ra_status":"%s","identification":"%s","login":"%s","operator_session":%s,"rich_presence":"%s","hardcore":"not_run","session_exit":"%s","save_flush":"%s","unlock_test":"%s"}\n' \
    "$2" "$reported_core" "$core_sha" "$core_status" "$identification" "$login" "$operator_session" "$rich_presence" "$session_exit" "$save_flush" "$unlock_test"
