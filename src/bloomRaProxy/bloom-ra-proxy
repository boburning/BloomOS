#!/bin/sh
set -eu
umask 077

UPSTREAM=${BLOOM_RA_PROXY_UPSTREAM:-/mnt/SDCARD/.bloom/components/raofflineproxy/bin/raofflineproxy}
CONFIG_DIR=${BLOOM_RA_PROXY_CONFIG_DIR:-/mnt/SDCARD/.bloom/achievements/proxy}
LOG_FILE=${BLOOM_RA_PROXY_LOG_FILE:-/mnt/SDCARD/.bloom/logs/raofflineproxy.log}
ROM_ROOT=${BLOOM_RA_PROXY_ROM_ROOT:-/mnt/SDCARD/Roms}
PROXY_HOST=127.0.0.1:8080
RA_BIN=${BLOOM_RA_BIN:-/mnt/SDCARD/.tmp_update/bin/bloom-ra}
JQ_BIN=${BLOOM_JQ_BIN:-/mnt/SDCARD/.tmp_update/bin/jq}
CREDENTIALS=${BLOOM_RA_CREDENTIALS:-/appconfigs/bloom/achievements/credentials}
RUNTIME_DIR=${BLOOM_RA_PROXY_RUNTIME_DIR:-/tmp/bloom-ra-proxy}
RUNTIME_ACCOUNT=$RUNTIME_DIR/credentials.append

json_error() {
    printf '{"schema":1,"service":"bloom-ra-proxy","error":{"code":"%s"}}\n' "$1" >&2
    exit 1
}

installed() {
    [ -f "$UPSTREAM" ] && [ -x "$UPSTREAM" ] && [ ! -L "$UPSTREAM" ]
}

run_upstream() {
    RAOFFLINEPROXY_CONFIG_DIR="$CONFIG_DIR" "$UPSTREAM" "$@"
}

safe_json() {
    value=$1
    [ "${#value}" -le 4096 ] || json_error invalid_upstream_response
    newline='
'
    case "$value" in
        *"$newline"*) json_error invalid_upstream_response ;;
        \{*\}) printf '%s' "$value" ;;
        *) json_error invalid_upstream_response ;;
    esac
}

service_status() {
    run_upstream home-status 2>/dev/null || json_error upstream_unavailable
}

validate_endpoint_config() {
    config_file="$CONFIG_DIR/config.json"
    [ ! -e "$config_file" ] || { [ -f "$config_file" ] && [ ! -L "$config_file" ]; } || json_error unsafe_config_path
    if [ -f "$config_file" ] && grep -Eq '"proxy_(host|port)"[[:space:]]*:' "$config_file"; then
        json_error unsupported_endpoint_override
    fi
}

sync_account() {
    [ -x "$RA_BIN" ] && [ -x "$JQ_BIN" ] || json_error account_unavailable
    [ -f "$CREDENTIALS" ] && [ ! -L "$CREDENTIALS" ] || json_error account_unavailable
    account=$("$RA_BIN" account launch 2>/dev/null) || json_error account_unavailable
    username=$(printf '%s' "$account" | "$JQ_BIN" -er '.username | select(type == "string" and length > 0)' 2>/dev/null) ||
        json_error account_unavailable
    authenticated=$(printf '%s' "$account" | "$JQ_BIN" -er '.authenticated | select(type == "boolean")' 2>/dev/null) ||
        json_error account_unavailable
    [ "$authenticated" = true ] || json_error account_unavailable
    token=''
    IFS= read -r token <"$CREDENTIALS" || [ -n "$token" ] || json_error account_unavailable
    case "$username$token" in *[!A-Za-z0-9_.@-]*) json_error account_invalid ;; esac
    [ -n "$token" ] || json_error account_invalid
    [ ! -L "$RUNTIME_DIR" ] || json_error unsafe_runtime_path
    [ ! -e "$RUNTIME_DIR" ] || [ -d "$RUNTIME_DIR" ] || json_error unsafe_runtime_path
    mkdir -p "$RUNTIME_DIR"
    chmod 700 "$RUNTIME_DIR"
    account_temp=$RUNTIME_ACCOUNT.tmp.$$
    printf 'cheevos_username = "%s"\ncheevos_token = "%s"\n' "$username" "$token" >"$account_temp"
    chmod 600 "$account_temp"
    mv -f "$account_temp" "$RUNTIME_ACCOUNT"

    config_file=$CONFIG_DIR/config.json
    config_temp=$CONFIG_DIR/config.json.tmp.$$
    if [ -f "$config_file" ]; then
        "$JQ_BIN" -e --arg path "$RUNTIME_ACCOUNT" 'select(type == "object") | . + {retroarch_cfg:$path}' \
            "$config_file" >"$config_temp" || { rm -f "$config_temp"; json_error invalid_upstream_config; }
    else
        "$JQ_BIN" -n --arg path "$RUNTIME_ACCOUNT" '{retroarch_cfg:$path}' >"$config_temp" || json_error account_unavailable
    fi
    chmod 600 "$config_temp"
    mv -f "$config_temp" "$config_file"
    token=''
}

prepare_runtime_paths() {
    [ ! -L "$CONFIG_DIR" ] || json_error unsafe_config_path
    [ ! -e "$CONFIG_DIR" ] || [ -d "$CONFIG_DIR" ] || json_error unsafe_config_path
    log_dir=$(dirname "$LOG_FILE")
    [ ! -L "$log_dir" ] || json_error unsafe_log_path
    [ ! -e "$LOG_FILE" ] || { [ -f "$LOG_FILE" ] && [ ! -L "$LOG_FILE" ]; } || json_error unsafe_log_path
    mkdir -p "$CONFIG_DIR" "$log_dir"
    if [ -f "$LOG_FILE" ] && [ "$(wc -c <"$LOG_FILE")" -gt 262144 ]; then
        mv -f "$LOG_FILE" "$LOG_FILE.1"
    fi
}

system_folder() {
    case "$1" in
        gb) printf GB ;; gbc) printf GBC ;; gba) printf GBA ;; nes) printf FC ;; fds) printf FDS ;;
        snes) printf SFC ;; psx) printf PS ;; genesis) printf MD ;; segacd) printf SEGACD ;;
        32x) printf THIRTYTWOX ;; gamegear) printf GG ;; mastersystem) printf MS ;; sg1000) printf SEGASGONE ;;
        arcade) printf ARCADE ;; cps1) printf CPS1 ;; cps2) printf CPS2 ;; cps3) printf CPS3 ;; neogeo) printf NEOGEO ;;
        atari2600) printf ATARI ;; atari7800) printf SEVENTYEIGHTHUNDRED ;; lynx) printf LYNX ;;
        pce) printf PCE ;; pcecd) printf PCECD ;; supergrafx) printf SGFX ;; virtualboy) printf VB ;;
        wonderswan) printf WS ;; ngpc) printf NGP ;; coleco) printf COLECO ;; msx) printf MSX ;;
        amstrad) printf CPC ;; amiga) printf AMIGA ;; *) return 1 ;;
    esac
}

validated_rom() {
    [ ! -L "$1" ] && [ -f "$1" ] || return 1
    resolved=$(readlink -f "$1") || return 1
    root=$(readlink -f "$ROM_ROOT") || return 1
    case "$resolved" in "$root"/*) printf '%s' "$resolved" ;; *) return 1 ;; esac
}

print_status() {
    if ! installed; then
        printf '%s\n' '{"schema":1,"service":"bloom-ra-proxy","installed":false,"running":false,"state":"not_installed"}'
        return
    fi
    home=$(run_upstream home-status 2>/dev/null) || json_error upstream_unavailable
    printf '{"schema":1,"service":"bloom-ra-proxy","installed":true,"state":"ready","upstream":'
    safe_json "$home"
    printf '}\n'
}

start_service() {
    installed || json_error not_installed
    validate_endpoint_config
    prepare_runtime_paths
    sync_account
    before=$(service_status)
    case "$before" in *'"service_running":true'*) print_status; return ;; esac
    RAOFFLINEPROXY_CONFIG_DIR="$CONFIG_DIR" nohup "$UPSTREAM" run-service >>"$LOG_FILE" 2>&1 &
    attempts=0
    while [ "$attempts" -lt 20 ]; do
        current=$(service_status)
        case "$current" in *'"service_running":true'*) print_status; return ;; esac
        attempts=$((attempts + 1))
        sleep 1
    done
    json_error start_failed
}

stop_service() {
    installed || json_error not_installed
    current=$(service_status)
    pid=$(printf '%s' "$current" | sed -n 's/.*"service_pid":[ ]*\([0-9][0-9]*\).*/\1/p')
    if [ -z "$pid" ]; then
        rm -f "$RUNTIME_ACCOUNT"
        printf '%s\n' '{"schema":1,"service":"bloom-ra-proxy","installed":true,"running":false,"state":"stopped"}'
        return
    fi
    cmdline=$(tr '\000' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)
    case "$cmdline" in *raofflineproxy*) kill "$pid" ;; *) json_error unsafe_service_pid ;; esac
    rm -f "$RUNTIME_ACCOUNT"
    printf '%s\n' '{"schema":1,"service":"bloom-ra-proxy","installed":true,"running":false,"state":"stopped"}'
}

case "${1:-}" in
    status|health) [ "$#" -eq 1 ] || json_error invalid_arguments; print_status ;;
    start) [ "$#" -eq 1 ] || json_error invalid_arguments; start_service ;;
    stop) [ "$#" -eq 1 ] || json_error invalid_arguments; stop_service ;;
    endpoint)
        [ "$#" -eq 1 ] || json_error invalid_arguments
        installed || json_error not_installed
        validate_endpoint_config
        printf '{"schema":1,"service":"bloom-ra-proxy","host":"%s"}\n' "$PROXY_HOST"
        ;;
    pending)
        [ "$#" -eq 1 ] || json_error invalid_arguments
        installed || json_error not_installed
        count=$(run_upstream pending-awards-count 2>/dev/null) || json_error upstream_unavailable
        case "$count" in ''|*[!0-9]*) json_error invalid_upstream_response ;; esac
        printf '{"schema":1,"service":"bloom-ra-proxy","pending_awards":%s}\n' "$count"
        ;;
    cached-game)
        [ "$#" -eq 2 ] || json_error invalid_arguments
        case "$2" in ''|*[!0-9]*|0) json_error invalid_game_id ;; esac
        installed || json_error not_installed
        if run_upstream cached-games 2>/dev/null | grep -Eq "##GAMEID:${2}$"; then cached=true; else cached=false; fi
        printf '{"schema":1,"service":"bloom-ra-proxy","ra_game_id":%s,"cached":%s}\n' "$2" "$cached"
        ;;
    cache-rom)
        [ "$#" -eq 2 ] || json_error invalid_arguments
        installed || json_error not_installed
        rom=$(validated_rom "$2") || json_error invalid_rom_path
        validate_endpoint_config
        prepare_runtime_paths
        sync_account
        if run_upstream cache-rom --path "$rom" >/dev/null 2>&1; then
            rm -f "$RUNTIME_ACCOUNT"
        else
            rm -f "$RUNTIME_ACCOUNT"
            json_error cache_failed
        fi
        printf '%s\n' '{"schema":1,"service":"bloom-ra-proxy","cached":true}'
        ;;
    cache-system)
        [ "$#" -eq 2 ] || json_error invalid_arguments
        installed || json_error not_installed
        folder=$(system_folder "$2") || json_error invalid_system
        root=$(readlink -f "$ROM_ROOT") || json_error invalid_rom_root
        directory="$root/$folder"
        [ ! -L "$directory" ] && [ -d "$directory" ] || json_error invalid_system_path
        validate_endpoint_config
        prepare_runtime_paths
        sync_account
        if run_upstream cache-folder-listing --path "$directory"; then
            rm -f "$RUNTIME_ACCOUNT"
        else
            rm -f "$RUNTIME_ACCOUNT"
            json_error cache_failed
        fi
        ;;
    *) json_error invalid_command ;;
esac
