#!/bin/sh
set -eu
umask 077

LOG_DIR=${BLOOM_RA_LOG_DIR:-/appconfigs/bloom/logs}
LOG_FILE=$LOG_DIR/retroachievements.log
ROTATED=$LOG_FILE.1
MAX_BYTES=${BLOOM_RA_LOG_MAX_BYTES:-65536}

fail() { printf 'bloom-ra-log: %s\n' "$*" >&2; exit 1; }
safe_word() { case "$1" in ''|*[!A-Za-z0-9_.-]*) return 1 ;; esac; }

case "$MAX_BYTES" in ''|*[!0-9]*) fail "invalid log limit" ;; esac
[ "$MAX_BYTES" -ge 1024 ] && [ "$MAX_BYTES" -le 1048576 ] || fail "invalid log limit"
case "${1:-}" in
    export)
        [ "$#" -eq 1 ] || fail "export expects no arguments"
        [ ! -e "$LOG_FILE" ] && exit 0
        [ -f "$LOG_FILE" ] && [ ! -L "$LOG_FILE" ] || fail "log path is unsafe"
        awk -F '"' '
            function safe_word(value) { return value ~ /^[A-Za-z0-9_.-]+$/ && length(value) <= 64 }
            function valid_prefix() {
                return $1 == "{" && $2 == "schema" && $3 == ":1," &&
                       $4 == "event" && $5 == ":"
            }
            $6 == "launch" && NF == 27 && valid_prefix() &&
                $7 == "," && $8 == "mode" && $9 == ":" &&
                ($10 == "softcore" || $10 == "hardcore") &&
                $11 == "," && $12 == "transport" && $13 == ":" &&
                ($14 == "direct" || $14 == "proxy") &&
                $15 == "," && $16 == "core" && $17 == ":" &&
                $18 ~ /^[A-Za-z0-9_.-]+_libretro[.]so$/ &&
                $19 == "," && $20 == "core_sha256" && $21 == ":" &&
                $22 ~ /^[0-9a-f]+$/ && length($22) == 64 &&
                $23 == "," && $24 == "core_certification" && $25 == ":" &&
                ($26 == "verified" || $26 == "best_effort" ||
                 $26 == "incompatible" || $26 == "untested") && $27 == "}" {
                    expected = "{\"schema\":1,\"event\":\"launch\",\"mode\":\"" $10
                    expected = expected "\",\"transport\":\"" $14 "\",\"core\":\"" $18
                    expected = expected "\",\"core_sha256\":\"" $22
                    expected = expected "\",\"core_certification\":\"" $26 "\"}"
                    if ($0 == expected) print expected
                    next
                }
            $6 == "finish" && NF == 15 && valid_prefix() &&
                $7 == "," && $8 == "outcome" && $9 == ":" &&
                ($10 == "stopped" || $10 == "failed") &&
                $11 == "," && $12 == "detail" && $13 == ":" &&
                safe_word($14) && $15 == "}" {
                    expected = "{\"schema\":1,\"event\":\"finish\",\"outcome\":\"" $10
                    original = expected "\",\"detail\":\"" $14 "\"}"
                    if ($0 == original) print expected "\"}"
                    next
                }
            $6 == "prepare_failure" && NF == 11 && valid_prefix() &&
                $7 == "," && $8 == "category" && $9 == ":" &&
                ($10 == "account_invalid" || $10 == "hardcore_unidentified" ||
                 $10 == "request_invalid" || $10 == "core_unavailable" ||
                 $10 == "core_policy_invalid" || $10 == "hardcore_incompatible" ||
                 $10 == "proxy_unavailable" || $10 == "config_generation_failed") &&
                $11 == "}" {
                    expected = "{\"schema\":1,\"event\":\"prepare_failure\",\"category\":\"" $10 "\"}"
                    if ($0 == expected) print expected
                }
        ' "$LOG_FILE"
        exit 0
        ;;
    launch)
        [ "$#" -eq 6 ] || fail "launch expects MODE TRANSPORT CORE SHA CERTIFICATION"
        mode=$2 transport=$3 core=$4 sha=$5 certification=$6
        case "$mode" in softcore|hardcore) ;; *) fail "invalid mode" ;; esac
        case "$transport" in direct|proxy) ;; *) fail "invalid transport" ;; esac
        case "$core" in *_libretro.so) safe_word "$core" || fail "invalid core" ;; *) fail "invalid core" ;; esac
        case "$sha" in *[!0-9a-f]*|'') fail "invalid core SHA" ;; esac
        [ "${#sha}" -eq 64 ] || fail "invalid core SHA"
        case "$certification" in verified|best_effort|incompatible|untested) ;; *) fail "invalid certification" ;; esac
        line=$(printf '{"schema":1,"event":"launch","mode":"%s","transport":"%s","core":"%s","core_sha256":"%s","core_certification":"%s"}' \
            "$mode" "$transport" "$core" "$sha" "$certification")
        ;;
    finish)
        [ "$#" -eq 3 ] || fail "finish expects OUTCOME DETAIL"
        outcome=$2 detail=$3
        case "$outcome" in stopped|failed) ;; *) fail "invalid outcome" ;; esac
        safe_word "$detail" || fail "invalid detail"
        line=$(printf '{"schema":1,"event":"finish","outcome":"%s","detail":"%s"}' "$outcome" "$detail")
        ;;
    prepare-failure)
        [ "$#" -eq 2 ] || fail "prepare-failure expects CATEGORY"
        category=$2
        case "$category" in
            account_invalid|hardcore_unidentified|request_invalid|core_unavailable|core_policy_invalid|hardcore_incompatible|proxy_unavailable|config_generation_failed) ;;
            *) fail "invalid failure category" ;;
        esac
        line=$(printf '{"schema":1,"event":"prepare_failure","category":"%s"}' "$category")
        ;;
    *) fail "expected {export|launch|finish|prepare-failure}" ;;
esac

[ ! -L "$LOG_DIR" ] && [ ! -L "$LOG_FILE" ] && [ ! -L "$ROTATED" ] || fail "log path is unsafe"
mkdir -p "$LOG_DIR" || fail "cannot create log directory"
[ -d "$LOG_DIR" ] || fail "log directory is unavailable"

if [ -f "$LOG_FILE" ] && [ "$(wc -c <"$LOG_FILE")" -ge "$MAX_BYTES" ]; then
    [ ! -e "$ROTATED" ] || rm -f "$ROTATED"
    mv "$LOG_FILE" "$ROTATED" || fail "cannot rotate log"
fi
printf '%s\n' "$line" >>"$LOG_FILE" || fail "cannot append log"
chmod 600 "$LOG_FILE" || fail "cannot protect log"
