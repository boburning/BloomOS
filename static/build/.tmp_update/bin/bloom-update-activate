#!/bin/sh
set -u

SD_ROOT="${BLOOM_SD_ROOT:-/mnt/SDCARD}"
UPDATE_ROOT="${BLOOM_UPDATE_ROOT:-$SD_ROOT/.bloom/update}"
STATE_BIN="${BLOOM_UPDATE_STATE_BIN:-$SD_ROOT/.tmp_update/bin/bloom-update-state}"
SNAPSHOT_BIN="${BLOOM_SAVE_SNAPSHOT_BIN:-$SD_ROOT/.tmp_update/bin/bloom-save-snapshot}"
JQ="${BLOOM_JQ_BIN:-$SD_ROOT/.tmp_update/bin/jq}"
MOUNT="${BLOOM_MOUNT_BIN:-mount}"
UMOUNT="${BLOOM_UMOUNT_BIN:-umount}"

fail() { printf 'bloom-update-activate: %s\n' "$*" >&2; exit 1; }

[ "$#" -eq 1 ] || fail "expected VERSION"
version="$1"
case "$version" in ''|*[!A-Za-z0-9._+-]*) fail "version is unsafe" ;; esac
[ -x "$STATE_BIN" ] || fail "update state service is unavailable"
[ -x "$SNAPSHOT_BIN" ] || fail "save snapshot service is unavailable"
[ -x "$JQ" ] || fail "jq is unavailable"

state="$($STATE_BIN status)" || fail "cannot read update state"
[ "$(printf '%s\n' "$state" | "$JQ" -er '.phase')" = armed ] || fail "update is not armed"
[ "$(printf '%s\n' "$state" | "$JQ" -er '.pending_version')" = "$version" ] || fail "armed version does not match"
[ -f "$UPDATE_ROOT/known-good.json" ] && [ ! -L "$UPDATE_ROOT/known-good.json" ] || fail "no prior known-good release is retained"
known_good_path="$("$JQ" -er '.path' "$UPDATE_ROOT/known-good.json")" || fail "known-good state is invalid"
[ -d "$known_good_path" ] && [ ! -L "$known_good_path" ] || fail "known-good payload is unavailable"

candidate="$UPDATE_ROOT/candidates/$version"
[ -d "$candidate" ] && [ ! -L "$candidate" ] || fail "prepared candidate is unavailable"
source_app="$candidate/miyoo/app"
source_ra="$candidate/RetroArch"
[ -f "$source_app/MainUI" ] && [ -d "$source_app/.tmp_update" ] || fail "candidate installer is incomplete"
[ -f "$source_ra/retroarch.pak" ] || fail "candidate RetroArch payload is incomplete"

target_app="$SD_ROOT/miyoo/app"
target_ra="$SD_ROOT/RetroArch"
legacy_host_key="$SD_ROOT/.tmp_update/etc/dropbear/dropbear_ed25519_host_key"
durable_host_key_dir="$SD_ROOT/.bloom/ssh"
durable_host_key="$durable_host_key_dir/dropbear_ed25519_host_key"
mkdir -p "$target_app" "$target_ra" || fail "cannot create activation targets"
[ ! -L "$target_app/MainUI" ] || fail "an installer is already pending"
if [ -f "$target_app/MainUI" ] && grep -Fq '#!/bin/sh' "$target_app/MainUI"; then
    fail "an installer is already pending"
fi
[ ! -e "$target_app/.tmp_update" ] || fail "an installer is already pending"
[ ! -e "$target_ra/retroarch.pak" ] || fail "a RetroArch installer is already pending"

snapshot="$($SNAPSHOT_BIN create pre-update)" || fail "pre-update save snapshot failed"
snapshot_id="$(printf '%s\n' "$snapshot" | "$JQ" -er '.id')" || fail "snapshot result is invalid"
$STATE_BIN activation-start "$version" "$snapshot_id" >/dev/null || fail "cannot record activation"
if [ ! -s "$durable_host_key" ] && [ -s "$legacy_host_key" ]; then
    mkdir -p "$durable_host_key_dir" || fail "cannot create durable SSH key directory"
    chmod 700 "$durable_host_key_dir" || fail "cannot protect durable SSH key directory"
    cp "$legacy_host_key" "$durable_host_key" || fail "cannot preserve SSH host key"
    chmod 600 "$durable_host_key" || fail "cannot protect durable SSH host key"
fi

temporary_app="$target_app/.bloom-candidate-$$"
temporary_ra="$target_ra/.bloom-candidate-$$.pak"
temporary_trigger="$target_app/.bloom-MainUI-$$"
cleanup() { rm -rf "$temporary_app"; rm -f "$temporary_ra" "$temporary_trigger"; }
trap cleanup EXIT HUP INT TERM
cp -R "$source_app/.tmp_update" "$temporary_app" || fail "cannot stage installer payload"
cp "$source_ra/retroarch.pak" "$temporary_ra" || fail "cannot stage RetroArch payload"
cp "$source_app/MainUI" "$temporary_trigger" || fail "cannot stage installer trigger"
sync
mv "$temporary_app" "$target_app/.tmp_update" || fail "cannot publish installer payload"
mv "$temporary_ra" "$target_ra/retroarch.pak" || fail "cannot publish RetroArch payload"
sync
if "$MOUNT" | grep -Fq " on $target_app/MainUI "; then
    "$UMOUNT" -l "$target_app/MainUI" || fail "cannot detach the active MainUI mount"
fi
mv "$temporary_trigger" "$target_app/MainUI" || fail "cannot publish installer trigger"
trap - EXIT HUP INT TERM
sync
printf '{"schema":1,"status":"activation_pending","version":"%s","snapshot_id":"%s"}\n' "$version" "$snapshot_id"
