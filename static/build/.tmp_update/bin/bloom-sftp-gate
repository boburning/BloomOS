#!/bin/sh
set -eu

ROOT=${BLOOM_ROOT:-}
STATE_DIR="$ROOT/mnt/SDCARD/.bloom/network-services"
SERVER=${BLOOM_SFTP_SERVER:-$ROOT/mnt/SDCARD/.tmp_update/bin/bloom-sftp-server}
LIBRARY_DIR="$ROOT/mnt/SDCARD/.tmp_update/lib"

[ -f "$STATE_DIR/sftp.enabled" ] || exit 1
[ -x "$SERVER" ] || exit 1
LD_LIBRARY_PATH="$LIBRARY_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LD_LIBRARY_PATH
exec "$SERVER"
