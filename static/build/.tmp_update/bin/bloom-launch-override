#!/bin/sh
set -u

SD_ROOT="${BLOOM_SD_ROOT:-/mnt/SDCARD}"

fail() { printf 'bloom-launch-override: %s\n' "$*" >&2; exit 1; }

valid_launcher() {
    case "$1" in
        "$SD_ROOT"/Emu/*/launch.sh|"$SD_ROOT"/RApp/*/launch.sh) ;;
        *) return 1 ;;
    esac
    [ -f "$1" ] && [ ! -L "$1" ] && [ "$(realpath "$1")" = "$1" ]
}

case "${1:-}" in
    create)
        [ "$#" -eq 3 ] || fail "create expects LAUNCHER APPEND_CONFIG"
        launcher="$2"
        append_config="$3"
        valid_launcher "$launcher" || fail "launcher path is unsafe"
        case "$append_config" in /tmp/reset.cfg|/tmp/auto_load_state.cfg) ;; *) fail "append config is unsupported" ;; esac
        directory="$(dirname "$launcher")"
        temporary="$directory/.bloom-launch-override-$$.sh"
        [ ! -e "$temporary" ] || fail "temporary launcher already exists"
        cleanup() { rm -f "$temporary"; }
        trap cleanup EXIT HUP INT TERM
        awk -v config="$append_config" '
            !changed && sub(/[[:space:]]-v[[:space:]]/, " -v --appendconfig \"" config "\" ") { changed=1 }
            { print }
            END { if (!changed) exit 42 }
        ' "$launcher" >"$temporary" || fail "launcher does not expose a RetroArch command"
        chmod 700 "$temporary" || fail "cannot protect temporary launcher"
        trap - EXIT HUP INT TERM
        printf '%s\n' "$temporary"
        ;;
    remove)
        [ "$#" -eq 2 ] || fail "remove expects TEMPORARY_LAUNCHER"
        temporary="$2"
        case "$temporary" in
            "$SD_ROOT"/Emu/*/.bloom-launch-override-[0-9]*.sh|"$SD_ROOT"/RApp/*/.bloom-launch-override-[0-9]*.sh) ;;
            *) fail "temporary launcher path is unsafe" ;;
        esac
        [ ! -L "$temporary" ] && [ -f "$temporary" ] && [ "$(realpath "$temporary")" = "$temporary" ] ||
            fail "temporary launcher path is unsafe"
        rm -f "$temporary" || fail "cannot remove temporary launcher"
        ;;
    *) fail "expected {create LAUNCHER APPEND_CONFIG|remove TEMPORARY_LAUNCHER}" ;;
esac
