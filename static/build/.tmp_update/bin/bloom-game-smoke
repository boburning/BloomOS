#!/bin/sh
set -u

SD_ROOT="${BLOOM_SD_ROOT:-/mnt/SDCARD}"
SYS_DIR="$SD_ROOT/.tmp_update"
COMMAND_FILE="$SYS_DIR/cmd_to_run.sh"
REQUEST_FILE="$SYS_DIR/bloom-launch-request.json"
BLOOM_LAUNCH="$SYS_DIR/bin/bloom-launch"
BLOOM_GAME_ID="$SYS_DIR/bin/bloom-game-id"
BLOOM_SESSION="$SYS_DIR/bin/bloom-session"
KEEP_SERVICES="$SYS_DIR/config/.keepServicesAlive"
SYSTEM="${1:-}"
ROM_B64="${2:-}"
DURATION="${3:-10}"
CREATED_KEEP_SERVICES=0
CREATED_REQUEST=0
RETROARCH_PID=""

fail() {
    printf '{"schema":1,"status":"failed","reason":"%s"}\n' "$1"
    exit 1
}

retroarch_pid() {
    for proc in /proc/[0-9]*; do
        [ "$(cat "$proc/comm" 2>/dev/null)" = retroarch ] || continue
        printf '%s\n' "${proc##*/}"
        return 0
    done
    return 1
}

cleanup() {
    if [ -n "$RETROARCH_PID" ] && kill -0 "$RETROARCH_PID" 2>/dev/null; then
        kill -TERM "$RETROARCH_PID" 2>/dev/null || true
    fi
    if [ "$CREATED_KEEP_SERVICES" -eq 1 ]; then
        rm -f "$KEEP_SERVICES"
    fi
    if [ "$CREATED_REQUEST" -eq 1 ]; then
        rm -f "$REQUEST_FILE"
    fi
    if [ -x "$BLOOM_SESSION" ]; then
        "$BLOOM_SESSION" fail smoke_cleanup >/dev/null 2>&1 || true
    fi
}
trap cleanup EXIT HUP INT TERM

[ -f "$SD_ROOT/.bloom-dev" ] || fail developer_mode_required
case "$DURATION" in
    ''|*[!0-9]*) fail invalid_duration ;;
esac
[ "$DURATION" -ge 5 ] && [ "$DURATION" -le 900 ] || fail invalid_duration

case "$SYSTEM" in
    GB) ROM_DIR=GB; SYSTEM_ID=gb; CORE=gambatte_libretro.so ;;
    GBC) ROM_DIR=GBC; SYSTEM_ID=gbc; CORE=gambatte_libretro.so ;;
    GBA) ROM_DIR=GBA; SYSTEM_ID=gba; CORE=gpsp_libretro.so ;;
    FC) ROM_DIR=FC; SYSTEM_ID=nes; CORE=fceumm_libretro.so ;;
    SFC) ROM_DIR=SFC; SYSTEM_ID=snes; CORE=mednafen_supafaust_libretro.so ;;
    PSX)
        ROM_DIR=PS
        SYSTEM_ID=psx
        CORE=pcsx_rearmed_libretro.so
        ;;
    *)
        fail unsupported_system
        ;;
esac

ROM_PATH="$(printf '%s' "$ROM_B64" | base64 -d 2>/dev/null)" || fail invalid_rom_encoding
case "$ROM_PATH" in
    "$SD_ROOT/Roms/$ROM_DIR/"*) ;;
    *) fail rom_outside_system_directory ;;
esac
[ -f "$ROM_PATH" ] || fail rom_not_found

LAUNCHER="$SD_ROOT/Emu/$SYSTEM/launch.sh"
[ -x "$LAUNCHER" ] || fail launcher_not_found
[ -x "$BLOOM_LAUNCH" ] || fail bloom_launch_not_found
[ -x "$BLOOM_GAME_ID" ] || fail bloom_game_id_not_found
[ -x "$BLOOM_SESSION" ] || fail bloom_session_not_found
[ ! -e "$COMMAND_FILE" ] || fail launch_already_pending
[ ! -e "$REQUEST_FILE" ] || fail request_already_pending
[ -z "$(retroarch_pid 2>/dev/null || true)" ] || fail retroarch_already_running
pidof MainUI >/dev/null 2>&1 || fail mainui_not_running

if [ ! -e "$KEEP_SERVICES" ]; then
    : >"$KEEP_SERVICES"
    CREATED_KEEP_SERVICES=1
fi

GAME_ID="$("$BLOOM_GAME_ID" "$SYSTEM_ID" "$ROM_PATH")" || fail game_id_failed
"$BLOOM_LAUNCH" create "$REQUEST_FILE" "$GAME_ID" "$SYSTEM_ID" \
    "$ROM_PATH" "$LAUNCHER" retroarch "$CORE" false || fail structured_request_failed
CREATED_REQUEST=1
"$BLOOM_LAUNCH" write-legacy "$REQUEST_FILE" "$COMMAND_FILE" || fail legacy_adapter_failed
"$BLOOM_SESSION" start "$REQUEST_FILE" || fail session_start_failed
"$BLOOM_SESSION" transition PREPARING STARTING || fail session_starting_failed
sync
killall MainUI >/dev/null 2>&1 || fail mainui_stop_failed

attempt=0
while [ "$attempt" -lt 60 ]; do
    RETROARCH_PID="$(retroarch_pid 2>/dev/null || true)"
    [ -n "$RETROARCH_PID" ] && break
    sleep 1
    attempt=$((attempt + 1))
done
[ -n "$RETROARCH_PID" ] || fail retroarch_start_timeout
"$BLOOM_SESSION" attach "$RETROARCH_PID" || fail session_attach_failed

START_RSS_KB="$(awk '/^VmRSS:/ { print $2; exit }' "/proc/$RETROARCH_PID/status")"
PEAK_RSS_KB="${START_RSS_KB:-0}"
elapsed=0
while [ "$elapsed" -lt "$DURATION" ]; do
    sleep 1
    kill -0 "$RETROARCH_PID" 2>/dev/null || fail retroarch_exited_early
    CURRENT_RSS_KB="$(awk '/^VmRSS:/ { print $2; exit }' "/proc/$RETROARCH_PID/status" 2>/dev/null || true)"
    case "$CURRENT_RSS_KB" in
        ''|*[!0-9]*) ;;
        *) [ "$CURRENT_RSS_KB" -le "$PEAK_RSS_KB" ] || PEAK_RSS_KB="$CURRENT_RSS_KB" ;;
    esac
    elapsed=$((elapsed + 1))
done
STOP_RESULT="$("$BLOOM_SESSION" stop-retroarch)" || fail session_stop_failed
SHUTDOWN_METHOD="$(printf '%s' "$STOP_RESULT" | sed -n 's/.*"shutdown_method":"\([a-z_]*\)".*/\1/p')"
case "$SHUTDOWN_METHOD" in retroarch_quit|sigterm|sigterm_fallback) ;; *) fail invalid_shutdown_method ;; esac
RETROARCH_PID=""
"$BLOOM_SESSION" flush-saves >/dev/null || fail save_flush_failed

attempt=0
while [ "$attempt" -lt 30 ]; do
    pidof MainUI >/dev/null 2>&1 && break
    sleep 1
    attempt=$((attempt + 1))
done
pidof MainUI >/dev/null 2>&1 || fail mainui_return_timeout
[ ! -e "$COMMAND_FILE" ] || fail command_cleanup_failed
"$BLOOM_SESSION" complete || fail session_complete_failed

printf '{"schema":1,"status":"passed","system":"%s","duration_seconds":%s,"rss_kb":%s,"start_rss_kb":%s,"peak_rss_kb":%s,"shutdown_method":"%s","session_state":"STOPPED","graceful_exit":true,"save_flush":true,"mainui_return":true,"command_cleanup":true}\n' \
    "$SYSTEM" "$DURATION" "$PEAK_RSS_KB" "${START_RSS_KB:-0}" "$PEAK_RSS_KB" "$SHUTDOWN_METHOD"
