#!/bin/sh

set -u

BLOOM_ROOT="${BLOOM_ROOT:-}"
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
BLOOM_PLATFORM="$SCRIPT_DIR/bloom-platform"

path() {
    printf '%s%s' "$BLOOM_ROOT" "$1"
}

read_first_line() {
    target="$(path "$1")"
    if [ -r "$target" ]; then
        IFS= read -r value <"$target" || true
        printf '%s' "${value:-}"
    fi
}

json_string() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/[^[:print:]]/?/g'
}

print_info_json() {
    model="$(sh "$BLOOM_PLATFORM" model)"
    raw_model="$(read_first_line /tmp/deviceModel)"
    serial="$(read_first_line /tmp/deviceSN)"
    version="$(read_first_line /mnt/SDCARD/.tmp_update/onionVersion/version.txt)"
    firmware="$(read_first_line /tmp/bloom-firmware-version)"
    display_width="$(sh "$BLOOM_PLATFORM" display-width)"
    display_height="$(sh "$BLOOM_PLATFORM" display-height)"
    has_wifi="$(sh "$BLOOM_PLATFORM" capability wifi)"
    has_ssh="$(sh "$BLOOM_PLATFORM" capability ssh)"
    has_lid="$(sh "$BLOOM_PLATFORM" capability lid)"
    has_rtc="$(sh "$BLOOM_PLATFORM" capability rtc)"
    has_input="$(sh "$BLOOM_PLATFORM" capability input)"
    has_battery="$(sh "$BLOOM_PLATFORM" capability battery)"
    if [ -e "$(path /mnt/SDCARD/.bloom-dev)" ]; then developer_mode=true; else developer_mode=false; fi
    developer_ssh="$(read_first_line /tmp/bloom-dev-ssh.state)"

    printf '{\n'
    printf '  "schema": 1,\n'
    printf '  "product": "BloomOS",\n'
    printf '  "version": "%s",\n' "$(json_string "${version:-unknown}")"
    printf '  "model": "%s",\n' "$(json_string "$model")"
    printf '  "model_id": "%s",\n' "$(json_string "${raw_model:-unknown}")"
    printf '  "hardware_revision": "unknown",\n'
    printf '  "serial": "%s",\n' "$(json_string "${serial:-unknown}")"
    printf '  "firmware": "%s",\n' "$(json_string "${firmware:-unknown}")"
    printf '  "display": {"width": "%s", "height": "%s"},\n' \
        "$(json_string "$display_width")" "$(json_string "$display_height")"
    printf '  "capabilities": {"wifi": %s, "ssh": %s, "lid": %s, "rtc": %s, "input": %s, "battery": %s},\n' \
        "$has_wifi" "$has_ssh" "$has_lid" "$has_rtc" "$has_input" "$has_battery"
    printf '  "developer_mode": %s,\n' "$developer_mode"
    printf '  "developer_ssh": "%s"\n' "$(json_string "${developer_ssh:-disabled}")"
    printf '}\n'
}

print_info_text() {
    model="$(sh "$BLOOM_PLATFORM" model)"
    version="$(read_first_line /mnt/SDCARD/.tmp_update/onionVersion/version.txt)"
    printf 'BloomOS %s\n' "${version:-unknown}"
    printf 'Model: %s\n' "$model"
    printf 'Hardware revision: unknown\n'
}

usage() {
    printf 'Usage: bloomctl info [--json]\n' >&2
}

case "${1:-}" in
    info)
        case "${2:-}" in
            '') print_info_text ;;
            --json) print_info_json ;;
            *) usage; exit 2 ;;
        esac
        ;;
    *) usage; exit 2 ;;
esac
