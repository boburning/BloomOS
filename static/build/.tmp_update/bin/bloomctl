#!/bin/sh

set -u

BLOOM_ROOT="${BLOOM_ROOT:-}"
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
BLOOM_PLATFORM="$SCRIPT_DIR/bloom-platform"
BLOOM_UPDATE_STAGE="${BLOOM_UPDATE_STAGE_BIN:-$SCRIPT_DIR/bloom-update-stage}"
BLOOM_UPDATE_PREPARE="${BLOOM_UPDATE_PREPARE_BIN:-$SCRIPT_DIR/bloom-update-prepare}"
BLOOM_UPDATE_STATE="${BLOOM_UPDATE_STATE_BIN:-$SCRIPT_DIR/bloom-update-state}"
BLOOM_UPDATE_BOOT="${BLOOM_UPDATE_BOOT_BIN:-$SCRIPT_DIR/bloom-update-boot}"
BLOOM_UPDATE_ROLLBACK="${BLOOM_UPDATE_ROLLBACK_BIN:-$SCRIPT_DIR/bloom-update-rollback}"
BLOOM_SYSTEM_HEALTH="${BLOOM_SYSTEM_HEALTH_BIN:-$SCRIPT_DIR/bloom-health-system}"
BLOOM_SAVE_SNAPSHOT="${BLOOM_SAVE_SNAPSHOT_BIN:-$SCRIPT_DIR/bloom-save-snapshot}"

path() {
    printf '%s%s' "$BLOOM_ROOT" "$1"
}

read_first_line() {
    target="$(path "$1")"
    if [ -r "$target" ]; then
        IFS= read -r value <"$target" || true
        printf '%s' "${value:-}"
    fi
}

json_string() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/[^[:print:]]/?/g'
}

print_info_json() {
    model="$(sh "$BLOOM_PLATFORM" model)"
    raw_model="$(read_first_line /tmp/deviceModel)"
    serial="$(read_first_line /tmp/deviceSN)"
    version="$(read_first_line /mnt/SDCARD/.tmp_update/onionVersion/version.txt)"
    firmware="$(read_first_line /tmp/bloom-firmware-version)"
    display_width="$(sh "$BLOOM_PLATFORM" display-width)"
    display_height="$(sh "$BLOOM_PLATFORM" display-height)"
    has_wifi="$(sh "$BLOOM_PLATFORM" capability wifi)"
    has_ssh="$(sh "$BLOOM_PLATFORM" capability ssh)"
    has_lid="$(sh "$BLOOM_PLATFORM" capability lid)"
    has_rtc="$(sh "$BLOOM_PLATFORM" capability rtc)"
    has_input="$(sh "$BLOOM_PLATFORM" capability input)"
    has_battery="$(sh "$BLOOM_PLATFORM" capability battery)"
    if [ -e "$(path /mnt/SDCARD/.bloom-dev)" ]; then developer_mode=true; else developer_mode=false; fi
    developer_ssh="$(read_first_line /tmp/bloom-dev-ssh.state)"

    printf '{\n'
    printf '  "schema": 1,\n'
    printf '  "product": "BloomOS",\n'
    printf '  "version": "%s",\n' "$(json_string "${version:-unknown}")"
    printf '  "model": "%s",\n' "$(json_string "$model")"
    printf '  "model_id": "%s",\n' "$(json_string "${raw_model:-unknown}")"
    printf '  "hardware_revision": "unknown",\n'
    printf '  "serial": "%s",\n' "$(json_string "${serial:-unknown}")"
    printf '  "firmware": "%s",\n' "$(json_string "${firmware:-unknown}")"
    printf '  "display": {"width": "%s", "height": "%s"},\n' \
        "$(json_string "$display_width")" "$(json_string "$display_height")"
    printf '  "capabilities": {"wifi": %s, "ssh": %s, "lid": %s, "rtc": %s, "input": %s, "battery": %s},\n' \
        "$has_wifi" "$has_ssh" "$has_lid" "$has_rtc" "$has_input" "$has_battery"
    printf '  "developer_mode": %s,\n' "$developer_mode"
    printf '  "developer_ssh": "%s"\n' "$(json_string "${developer_ssh:-disabled}")"
    printf '}\n'
}

print_info_text() {
    model="$(sh "$BLOOM_PLATFORM" model)"
    version="$(read_first_line /mnt/SDCARD/.tmp_update/onionVersion/version.txt)"
    printf 'BloomOS %s\n' "${version:-unknown}"
    printf 'Model: %s\n' "$model"
    printf 'Hardware revision: unknown\n'
}

play_activity_health() {
    play_activity="$(path /mnt/SDCARD/.tmp_update/bin/playActivity)"
    library_dir="$(path /mnt/SDCARD/.tmp_update/lib)"
    if [ ! -x "$play_activity" ]; then
        printf '%s' '{"schema":1,"healthy":false,"error":"unavailable"}'
        return 1
    fi

    LD_LIBRARY_PATH="$library_dir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" "$play_activity" health
}

system_health() {
    if [ ! -x "$BLOOM_SYSTEM_HEALTH" ]; then
        printf '%s' '{"schema":1,"healthy":false,"error":"unavailable"}'
        return 1
    fi
    "$BLOOM_SYSTEM_HEALTH"
}

print_health_json() {
    activity_output="$(play_activity_health)"
    activity_status=$?
    system_output="$(system_health)"
    system_status=$?
    case "$activity_output" in
        \{*) ;;
        *) activity_output='{"schema":1,"healthy":false,"error":"execution_failed"}' ;;
    esac
    case "$system_output" in
        \{*) ;;
        *) system_output='{"schema":1,"healthy":false,"error":"execution_failed"}' ;;
    esac
    if [ "$activity_status" -eq 0 ] && [ "$system_status" -eq 0 ]; then healthy=true; status=0; else healthy=false; status=1; fi

    printf '{\n'
    printf '  "schema": 1,\n'
    printf '  "healthy": %s,\n' "$healthy"
    printf '  "checks": {"system": %s, "play_activity": %s}\n' "$system_output" "$activity_output"
    printf '}\n'
    return "$status"
}

print_health_text() {
    activity_output="$(play_activity_health)"
    activity_status=$?
    system_output="$(system_health)"
    system_status=$?
    if [ "$system_status" -eq 0 ]; then printf 'System: healthy\n'; else printf 'System: unhealthy\n'; fi
    printf '%s\n' "$system_output"
    if [ "$activity_status" -eq 0 ]; then
        printf 'Play Activity: healthy\n'
    else
        printf 'Play Activity: unhealthy\n'
    fi
    printf '%s\n' "$activity_output"
    if [ "$activity_status" -eq 0 ] && [ "$system_status" -eq 0 ]; then return 0; else return 1; fi
}

usage() {
    printf 'Usage: bloomctl {info|health} [--json]\n' >&2
    printf '       bloomctl update {status|stage MANIFEST SIGNATURE ARCHIVE|prepare VERSION|arm VERSION|confirm|rollback}\n' >&2
    printf '       bloomctl saves snapshots\n' >&2
}

saves_command() {
    case "${1:-}" in
        snapshots)
            [ "$#" -eq 1 ] || { usage; return 2; }
            [ -x "$BLOOM_SAVE_SNAPSHOT" ] || { printf 'bloomctl: save snapshot service is unavailable\n' >&2; return 1; }
            "$BLOOM_SAVE_SNAPSHOT" list
            ;;
        *) usage; return 2 ;;
    esac
}

update_command() {
    action="${1:-}"
    case "$action" in
        status)
            [ "$#" -eq 1 ] || { usage; return 2; }
            [ -x "$BLOOM_UPDATE_STATE" ] || { printf 'bloomctl: update state service is unavailable\n' >&2; return 1; }
            "$BLOOM_UPDATE_STATE" status
            ;;
        stage)
            [ "$#" -eq 4 ] || { usage; return 2; }
            [ -x "$BLOOM_UPDATE_STAGE" ] || { printf 'bloomctl: update staging service is unavailable\n' >&2; return 1; }
            "$BLOOM_UPDATE_STAGE" "$2" "$3" "$4"
            ;;
        prepare)
            [ "$#" -eq 2 ] || { usage; return 2; }
            [ -x "$BLOOM_UPDATE_PREPARE" ] || { printf 'bloomctl: update candidate service is unavailable\n' >&2; return 1; }
            "$BLOOM_UPDATE_PREPARE" "$2"
            ;;
        arm)
            [ "$#" -eq 2 ] || { usage; return 2; }
            [ -x "$BLOOM_UPDATE_STATE" ] || { printf 'bloomctl: update state service is unavailable\n' >&2; return 1; }
            "$BLOOM_UPDATE_STATE" arm "$2"
            ;;
        confirm)
            [ "$#" -eq 1 ] || { usage; return 2; }
            [ -x "$BLOOM_UPDATE_BOOT" ] || { printf 'bloomctl: update boot service is unavailable\n' >&2; return 1; }
            "$BLOOM_UPDATE_BOOT" confirm
            ;;
        rollback)
            [ "$#" -eq 1 ] || { usage; return 2; }
            [ -x "$BLOOM_UPDATE_ROLLBACK" ] || { printf 'bloomctl: update rollback service is unavailable\n' >&2; return 1; }
            "$BLOOM_UPDATE_ROLLBACK"
            ;;
        *) usage; return 2 ;;
    esac
}

case "${1:-}" in
    info)
        case "${2:-}" in
            '') print_info_text ;;
            --json) print_info_json ;;
            *) usage; exit 2 ;;
        esac
        ;;
    health)
        case "${2:-}" in
            '') print_health_text ;;
            --json) print_health_json ;;
            *) usage; exit 2 ;;
        esac
        ;;
    update)
        shift
        update_command "$@"
        ;;
    saves)
        shift
        saves_command "$@"
        ;;
    *) usage; exit 2 ;;
esac
