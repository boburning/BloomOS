#!/bin/sh
set -u

ROOT="${BLOOM_ROOT:-}"
SD_ROOT="$ROOT/mnt/SDCARD"
TEST_ROOT="$SD_ROOT/BloomTest"
REQUEST="$TEST_ROOT/request.json"
RESULTS="$TEST_ROOT/results"
BLOOMCTL="$SD_ROOT/.tmp_update/bin/bloomctl"

fail() { printf 'bloom-test-runner: %s\n' "$*" >&2; exit 1; }

[ -e "$SD_ROOT/.bloom-dev" ] || fail "developer mode is not enabled"
[ -f "$REQUEST" ] || fail "test request not found"
grep -Eq '"safe_only"[[:space:]]*:[[:space:]]*true' "$REQUEST" || fail "unsafe request refused"
[ ! -e "$RESULTS/test-results.json" ] || exit 0
mkdir -p "$RESULTS"

if command -v fw_printenv >/dev/null 2>&1; then
    firmware="$(fw_printenv miyoo_version 2>/dev/null | sed 's/^[^=]*=//' || true)"
    [ -z "$firmware" ] || printf '%s\n' "$firmware" >"$ROOT/tmp/bloom-firmware-version"
fi

"$BLOOMCTL" info --json >"$RESULTS/device.json" || fail "device inspection failed"
{
    geometry="$(cat "$ROOT/sys/class/graphics/fb0/virtual_size" 2>/dev/null || true)"
    width="${geometry%%,*}"
    height="${geometry#*,}"
    if [ "$height" -gt 800 ] 2>/dev/null; then
        if [ $((height % 3)) -eq 0 ] && [ $((height / 3)) -ge 400 ] && [ $((height / 3)) -le 600 ]; then
            height=$((height / 3))
        elif [ $((height % 2)) -eq 0 ] && [ $((height / 2)) -ge 400 ] && [ $((height / 2)) -le 600 ]; then
            height=$((height / 2))
        fi
    fi
    printf 'physical_size=%s,%s\n' "${width:-unknown}" "${height:-unknown}"
    printf 'framebuffer_virtual_size=%s\n' "${geometry:-unknown}"
} >"$RESULTS/display.txt"
BATTERY_CAPACITY="$ROOT/sys/class/power_supply/battery/capacity"
BATMON_PERCENT="$ROOT/tmp/percBat"
AXP_RESULT="$ROOT/tmp/.axp_result"
if [ -r "$BATTERY_CAPACITY" ]; then
    {
        printf 'battery_source=sysfs\n'
        printf 'battery_capacity='
        cat "$BATTERY_CAPACITY"
    } >"$RESULTS/battery.txt"
elif [ -r "$BATMON_PERCENT" ]; then
    {
        printf 'battery_source=batmon\n'
        printf 'battery_capacity='
        cat "$BATMON_PERCENT"
    } >"$RESULTS/battery.txt"
elif [ -r "$AXP_RESULT" ]; then
    {
        printf 'battery_source=axp_cache\n'
        printf 'battery_raw='
        cat "$AXP_RESULT"
        printf '\n'
    } >"$RESULTS/battery.txt"
elif [ -x "$ROOT/customer/app/axp_test" ]; then
    axp_output="$("$ROOT/customer/app/axp_test" 2>/dev/null || true)"
    axp_capacity="$(printf '%s' "$axp_output" | sed -n 's/.*"battery"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p')"
    if [ -n "$axp_capacity" ]; then
        printf 'battery_source=axp_live\nbattery_capacity=%s\n' "$axp_capacity" >"$RESULTS/battery.txt"
    else
        printf 'battery_source=unavailable\nbattery_capacity=unknown\n' >"$RESULTS/battery.txt"
    fi
else
    printf 'battery_source=unavailable\nbattery_capacity=unknown\n' >"$RESULTS/battery.txt"
fi
{
    for event in "$ROOT"/dev/input/event*; do
        [ -e "$event" ] || continue
        printf '%s\n' "$event"
    done
} >"$RESULTS/input.txt"
{
    hall="$ROOT/sys/devices/soc0/soc/soc:hall-mh248/hallvalue"
    if [ -r "$hall" ]; then
        printf 'hall_sensor=present\n'
        printf 'lid_state_raw='
        cat "$hall"
    else
        printf 'hall_sensor=absent\n'
    fi
    if [ -e "$ROOT/customer/app/axp_test" ]; then
        printf 'axp=present\n'
    else
        printf 'axp=absent\n'
    fi
    event_count=0
    for event in "$ROOT"/dev/input/event*; do
        [ -e "$event" ] || continue
        event_count=$((event_count + 1))
    done
    printf 'input_event_count=%s\n' "$event_count"
} >"$RESULTS/platform.txt"
if [ -n "$ROOT" ]; then
    printf 'fixture boot log\n' >"$RESULTS/boot.log"
else
    dmesg >"$RESULTS/boot.log" 2>&1 || true
fi

cat >"$RESULTS/test-results.json" <<'EOF'
{
  "schema": 1,
  "status": "collected",
  "safe_only": true,
  "hardware_revision": "manual_confirmation_required",
  "destructive_tests": false
}
EOF
