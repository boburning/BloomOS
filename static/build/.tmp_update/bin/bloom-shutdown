#!/bin/sh
set -u

ROOT="${BLOOM_ROOT:-}"
SD_ROOT="$ROOT/mnt/SDCARD"
PROC_SWAPS="$ROOT/proc/swaps"

# FAT sets its dirty bit while mounted read-write. Onion historically handed
# control directly to the vendor shutdown command while a swapfile on the SD
# card was still active. Quiesce the volume and remount it read-only so the
# kernel clears that bit before the power controller cuts power.
sync
if [ -r "$PROC_SWAPS" ] && grep -Fq "$SD_ROOT/cachefile" "$PROC_SWAPS"; then
    swapoff "$SD_ROOT/cachefile" || true
fi
sync
mount -o remount,ro "$SD_ROOT" || true
sync

shutdown_command="${BLOOM_SHUTDOWN_COMMAND:-shutdown}"
exec "$shutdown_command" "$@"
