#!/bin/sh
set -eu

ROOT=${BLOOM_RA_NETWORK_ROOT:-}
PLATFORM=${BLOOM_PLATFORM_BIN:-/mnt/SDCARD/.tmp_update/bin/bloom-platform}
CURL=${BLOOM_CURL_BIN:-/mnt/SDCARD/.tmp_update/bin/curl}
DATE=${BLOOM_DATE_BIN:-date}
ENDPOINT=${BLOOM_RA_NETWORK_ENDPOINT:-https://retroachievements.org/}
LIB_DIR=${BLOOM_RA_NETWORK_LIB_DIR:-$ROOT/mnt/SDCARD/.tmp_update/lib}
CA_FILE=${BLOOM_RA_NETWORK_CA_FILE:-}

if [ -z "$CA_FILE" ]; then
    for candidate in \
        "$ROOT/mnt/SDCARD/.tmp_update/etc/ssl/certs/ca-certificates.crt" \
        "$ROOT/mnt/SDCARD/.bloom/components/raofflineproxy/runtime/python/lib/python3.9/site-packages/pip/_vendor/certifi/cacert.pem" \
        "$ROOT/etc/ssl/certs/ca-certificates.crt"; do
        if [ -f "$candidate" ] && [ ! -L "$candidate" ]; then
            CA_FILE=$candidate
            break
        fi
    done
fi

result() {
    printf '{"schema":1,"service":"bloom-ra-network","online":%s,"state":"%s"}\n' "$1" "$2"
}

[ "$#" -eq 1 ] && [ "$1" = status ] || { result false invalid_arguments; exit 2; }
[ -x "$PLATFORM" ] || { result false platform_unavailable; exit 1; }

wifi=$($PLATFORM capability wifi 2>/dev/null) || { result false platform_unavailable; exit 1; }
case "$wifi" in
    false) result false no_network_hardware; exit 0 ;;
    true) ;;
    *) result false platform_unavailable; exit 1 ;;
esac

interface=$ROOT/sys/class/net/wlan0
[ -d "$interface" ] || { result false wifi_disabled; exit 0; }
operstate=''
carrier=''
[ ! -r "$interface/operstate" ] || IFS= read -r operstate <"$interface/operstate" || true
[ ! -r "$interface/carrier" ] || IFS= read -r carrier <"$interface/carrier" || true
[ "$operstate" = up ] && [ "$carrier" = 1 ] || { result false not_associated; exit 0; }

epoch=$($DATE +%s 2>/dev/null) || { result false clock_invalid; exit 0; }
case "$epoch" in ''|*[!0-9]*) result false clock_invalid; exit 0 ;; esac
[ "$epoch" -ge 1577836800 ] || { result false clock_invalid; exit 0; }
[ -x "$CURL" ] || { result false tls_unavailable; exit 1; }
[ -n "$CA_FILE" ] && [ -f "$CA_FILE" ] && [ ! -L "$CA_FILE" ] || { result false tls_unavailable; exit 1; }

if http=$(LD_LIBRARY_PATH="/lib:/config/lib:$LIB_DIR:/customer/lib:$LIB_DIR/parasyte${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
    CURL_CA_BUNDLE="$CA_FILE" \
    "$CURL" --silent --show-error --output /dev/null --connect-timeout 5 \
    --max-time 10 --write-out '%{http_code}' "$ENDPOINT" 2>/dev/null); then
    case "$http" in
        2??|3??|401|403) result true ready ;;
        *) result false ra_service_failure; exit 1 ;;
    esac
else
    status=$?
    case "$status" in
        6) state=dns_failure ;;
        7) state=network_unreachable ;;
        28) state=timeout ;;
        35|51|58|60|77|80|82|83|90) state=tls_failure ;;
        *) state=ra_service_failure ;;
    esac
    result false "$state"
    exit 1
fi
