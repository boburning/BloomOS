#!/bin/sh
set -u

SD_ROOT="${BLOOM_SD_ROOT:-/mnt/SDCARD}"
PROFILE="$SD_ROOT/Saves/CurrentProfile"
SNAPSHOT_ROOT="$SD_ROOT/Saves/BloomSnapshots"
SESSION_STATE="${BLOOM_SESSION_STATE_FILE:-/tmp/bloom-session/state}"
UPDATE_STATE="${BLOOM_UPDATE_STATE_FILE:-$SD_ROOT/.bloom/update/state.json}"
JQ="${BLOOM_JQ_BIN:-$SD_ROOT/.tmp_update/bin/jq}"
RETENTION="${BLOOM_SNAPSHOT_RETENTION:-5}"
LOCK_DIR="$SNAPSHOT_ROOT/.lock"
LOCKED=0

fail() { printf 'bloom-save-snapshot: %s\n' "$*" >&2; exit 1; }

unlock() {
    if [ "$LOCKED" -eq 1 ]; then
        rmdir "$LOCK_DIR" 2>/dev/null || true
        LOCKED=0
    fi
}
trap unlock EXIT HUP INT TERM

lock() {
    mkdir -p "$SNAPSHOT_ROOT" || fail "cannot create snapshot root"
    mkdir "$LOCK_DIR" 2>/dev/null || fail "snapshot operation is busy"
    LOCKED=1
}

safe_name() {
    case "$1" in ''|*[!A-Za-z0-9_.-]*|.|..) return 1 ;; esac
}

validate_sources() {
    [ -d "$PROFILE/saves" ] || fail "save directory is unavailable"
    [ -d "$PROFILE/states" ] || fail "state directory is unavailable"
    if find "$PROFILE/saves" "$PROFILE/states" \( -type l -o ! -type d ! -type f \) | grep -q .; then
        fail "save trees contain unsupported entries"
    fi
}

verify_snapshot() {
    snapshot="$1"
    [ -f "$snapshot/complete" ] && [ -f "$snapshot/archive.sha256" ] && [ -f "$snapshot/saves.tar" ] || return 1
    (cd "$snapshot" && sha256sum -c archive.sha256 >/dev/null 2>&1)
}

referenced_snapshot() {
    [ -r "$UPDATE_STATE" ] && [ -x "$JQ" ] || return 1
    referenced="$("$JQ" -r '.snapshot_id // ""' "$UPDATE_STATE" 2>/dev/null)" || return 1
    [ "$referenced" = "$1" ]
}

prune_locked() {
    limit="$1"
    case "$limit" in ''|*[!0-9]*) fail "retention limit is invalid" ;; esac
    [ "$limit" -gt 0 ] || fail "retention limit is invalid"
    inventory="$SNAPSHOT_ROOT/.prune-$$"
    ordered="$SNAPSHOT_ROOT/.prune-ordered-$$"
    : >"$inventory" || fail "cannot create retention inventory"
    cleanup_prune() { rm -f "$inventory" "$ordered"; }
    trap 'cleanup_prune; unlock' EXIT HUP INT TERM
    for snapshot in "$SNAPSHOT_ROOT"/*; do
        [ -d "$snapshot" ] && [ ! -L "$snapshot" ] || continue
        snapshot_id="$(basename "$snapshot")"
        safe_name "$snapshot_id" || continue
        verify_snapshot "$snapshot" || continue
        printf '%s\n' "$snapshot_id" >>"$inventory" || fail "cannot write retention inventory"
    done
    sort -r "$inventory" >"$ordered" || fail "cannot order retention inventory"
    kept=0
    removed=0
    while IFS= read -r snapshot_id; do
        [ -n "$snapshot_id" ] || continue
        if referenced_snapshot "$snapshot_id"; then
            continue
        fi
        if [ "$kept" -lt "$limit" ]; then
            kept=$((kept + 1))
            continue
        fi
        snapshot="$SNAPSHOT_ROOT/$snapshot_id"
        [ -d "$snapshot" ] && [ ! -L "$snapshot" ] && verify_snapshot "$snapshot" ||
            fail "snapshot changed during retention"
        rm -rf "$snapshot" || fail "cannot remove expired snapshot"
        removed=$((removed + 1))
    done <"$ordered"
    cleanup_prune
    trap unlock EXIT HUP INT TERM
    printf '%s' "$removed"
}

prune_snapshots() {
    limit="$1"
    lock
    removed="$(prune_locked "$limit")" || fail "snapshot retention failed"
    printf '{"schema":1,"status":"pruned","retained":%s,"removed":%s}\n' "$limit" "$removed"
}

list_snapshots() {
    [ -x "$JQ" ] || fail "jq is unavailable"
    if [ ! -d "$SNAPSHOT_ROOT" ]; then
        printf '%s\n' '{"schema":1,"snapshots":[]}'
        return
    fi
    lock
    inventory="$SNAPSHOT_ROOT/.list-$$"
    : >"$inventory" || fail "cannot create snapshot inventory"
    for snapshot in "$SNAPSHOT_ROOT"/*; do
        [ -d "$snapshot" ] && [ ! -L "$snapshot" ] || continue
        snapshot_id="$(basename "$snapshot")"
        safe_name "$snapshot_id" || continue
        if verify_snapshot "$snapshot"; then snapshot_status=verified; else snapshot_status=unverified; fi
        trigger=unknown
        if [ -f "$snapshot/metadata.json" ] && [ ! -L "$snapshot/metadata.json" ]; then
            metadata_id="$("$JQ" -er '.id' "$snapshot/metadata.json" 2>/dev/null)" || metadata_id=""
            metadata_trigger="$("$JQ" -er '.trigger' "$snapshot/metadata.json" 2>/dev/null)" || metadata_trigger=""
            if [ "$metadata_id" = "$snapshot_id" ] && safe_name "$metadata_trigger"; then
                trigger="$metadata_trigger"
            else
                snapshot_status=unverified
            fi
        fi
        if [ -f "$snapshot/saves.tar" ] && [ ! -L "$snapshot/saves.tar" ]; then
            bytes="$(wc -c <"$snapshot/saves.tar" | tr -d ' ')"
        else
            bytes=0
        fi
        case "$bytes" in ''|*[!0-9]*) bytes=0 ;; esac
        if referenced_snapshot "$snapshot_id"; then referenced=true; else referenced=false; fi
        "$JQ" -cn --arg id "$snapshot_id" --arg trigger "$trigger" --arg status "$snapshot_status" \
            --argjson bytes "$bytes" --argjson referenced "$referenced" \
            '{id:$id,trigger:$trigger,status:$status,bytes:$bytes,referenced:$referenced}' >>"$inventory" ||
            fail "cannot serialize snapshot inventory"
    done
    "$JQ" -cs '{schema:1,snapshots:(sort_by(.id) | reverse)}' "$inventory" || fail "cannot publish snapshot inventory"
    rm -f "$inventory"
}

health_snapshots() {
    inventory="$(list_snapshots)" || fail "cannot inspect snapshot inventory"
    total="$(printf '%s\n' "$inventory" | "$JQ" -er '.snapshots | length')" || fail "snapshot inventory is invalid"
    unverified="$(printf '%s\n' "$inventory" | "$JQ" -er '[.snapshots[] | select(.status != "verified")] | length')" || fail "snapshot inventory is invalid"
    referenced="$(printf '%s\n' "$inventory" | "$JQ" -er '[.snapshots[] | select(.referenced == true)] | length')" || fail "snapshot inventory is invalid"
    if [ "$unverified" -eq 0 ]; then healthy=true; status=0; else healthy=false; status=1; fi
    "$JQ" -cn --argjson healthy "$healthy" --argjson total "$total" \
        --argjson unverified "$unverified" --argjson referenced "$referenced" \
        '{schema:1,healthy:$healthy,total:$total,unverified:$unverified,referenced:$referenced}'
    return "$status"
}

create_snapshot() {
    trigger="$1"
    safe_name "$trigger" || fail "invalid snapshot trigger"
    validate_sources
    lock
    timestamp="$(date -u +%Y%m%dT%H%M%SZ)" || fail "cannot read time"
    snapshot_id="${timestamp}-${trigger}-$$"
    safe_name "$snapshot_id" || fail "invalid snapshot identifier"
    staging="$SNAPSHOT_ROOT/.tmp.$snapshot_id"
    final="$SNAPSHOT_ROOT/$snapshot_id"
    [ ! -e "$staging" ] && [ ! -e "$final" ] || fail "snapshot already exists"
    mkdir "$staging" || fail "cannot stage snapshot"
    tar -cf "$staging/saves.tar" -C "$PROFILE" saves states || fail "cannot archive save trees"
    (cd "$staging" && sha256sum saves.tar >archive.sha256) || fail "cannot checksum snapshot"
    printf '{"schema":1,"id":"%s","trigger":"%s"}\n' "$snapshot_id" "$trigger" >"$staging/metadata.json" ||
        fail "cannot write snapshot metadata"
    : >"$staging/complete" || fail "cannot complete snapshot"
    verify_snapshot "$staging" || fail "staged snapshot failed verification"
    sync
    mv "$staging" "$final" || fail "cannot publish snapshot"
    removed="$(prune_locked "$RETENTION")" || fail "snapshot retention failed"
    printf '{"schema":1,"status":"created","id":"%s","trigger":"%s","retention":%s,"removed":%s}\n' \
        "$snapshot_id" "$trigger" "$RETENTION" "$removed"
}

restore_snapshot() {
    snapshot_id="$1"
    safe_name "$snapshot_id" || fail "invalid snapshot identifier"
    state=IDLE
    if [ -r "$SESSION_STATE" ]; then IFS= read -r state <"$SESSION_STATE" || true; fi
    case "$state" in IDLE|STOPPED|FAILED) ;; *) fail "cannot restore during an active session" ;; esac
    lock
    snapshot="$SNAPSHOT_ROOT/$snapshot_id"
    verify_snapshot "$snapshot" || fail "snapshot verification failed"
    restore_stage="$PROFILE/.bloom-restore.$$"
    rollback="$PROFILE/.bloom-rollback.$$"
    [ ! -e "$restore_stage" ] && [ ! -e "$rollback" ] || fail "restore staging already exists"
    mkdir "$restore_stage" "$rollback" || fail "cannot stage restore"
    tar -xf "$snapshot/saves.tar" -C "$restore_stage" || fail "cannot extract snapshot"
    [ -d "$restore_stage/saves" ] && [ -d "$restore_stage/states" ] || fail "snapshot scope is incomplete"
    mv "$PROFILE/saves" "$rollback/saves" || fail "cannot preserve current saves"
    if ! mv "$PROFILE/states" "$rollback/states"; then
        mv "$rollback/saves" "$PROFILE/saves" 2>/dev/null || true
        fail "cannot preserve current states"
    fi
    if ! mv "$restore_stage/saves" "$PROFILE/saves" || ! mv "$restore_stage/states" "$PROFILE/states"; then
        rm -rf "$PROFILE/saves" "$PROFILE/states"
        mv "$rollback/saves" "$PROFILE/saves" 2>/dev/null || true
        mv "$rollback/states" "$PROFILE/states" 2>/dev/null || true
        fail "cannot install restored save trees"
    fi
    rm -rf "$restore_stage" "$rollback"
    printf '{"schema":1,"status":"restored","id":"%s"}\n' "$snapshot_id"
}

usage() {
    printf 'Usage: bloom-save-snapshot create TRIGGER\n' >&2
    printf '       bloom-save-snapshot verify SNAPSHOT_ID\n' >&2
    printf '       bloom-save-snapshot restore SNAPSHOT_ID\n' >&2
    printf '       bloom-save-snapshot prune KEEP\n' >&2
    printf '       bloom-save-snapshot list\n' >&2
    printf '       bloom-save-snapshot health\n' >&2
}

case "${1:-}" in
    create) [ "$#" -eq 2 ] || { usage; exit 2; }; create_snapshot "$2" ;;
    verify)
        [ "$#" -eq 2 ] || { usage; exit 2; }
        safe_name "$2" || fail "invalid snapshot identifier"
        verify_snapshot "$SNAPSHOT_ROOT/$2" || fail "snapshot verification failed"
        printf '{"schema":1,"status":"verified","id":"%s"}\n' "$2"
        ;;
    restore) [ "$#" -eq 2 ] || { usage; exit 2; }; restore_snapshot "$2" ;;
    prune) [ "$#" -eq 2 ] || { usage; exit 2; }; prune_snapshots "$2" ;;
    list) [ "$#" -eq 1 ] || { usage; exit 2; }; list_snapshots ;;
    health) [ "$#" -eq 1 ] || { usage; exit 2; }; health_snapshots ;;
    *) usage; exit 2 ;;
esac
