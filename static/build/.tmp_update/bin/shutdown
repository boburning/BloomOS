#!/bin/sh

task_killer() {
	r=0
	for p in $1; do
		if [ -d "/proc/$p" ] && [ $p -ne $$ ]; then
			kill $2 $p
			r=1
		fi
	done
	return $r
}

kill_hooked_tasks() {
	c=0
	while [ $c -lt 5 ]; do
		pids=$(fuser -m /mnt/SDCARD)
		if task_killer "$pids" $1; then
			return
		fi
		sleep 0.05
		c=$((c + 1))
	done
}

SHUTDOWN_LOG_ENABLED=0

shutdown_log() {
	if [ "$SHUTDOWN_LOG_ENABLED" = "1" ]; then
		printf '%s\n' "$*" >> /appconfigs/bloom-shutdown.log
	fi
}

remount_sd_read_only() {
	mount -o remount,ro /mnt/SDCARD
	rc=$?
	shutdown_log "remount_ro_attempt_1=$rc"
	if [ $rc -ne 0 ]; then
		kill_hooked_tasks -9
		sync
		mount -o remount,ro /mnt/SDCARD
		rc=$?
		shutdown_log "remount_ro_attempt_2=$rc"
	fi
	return $rc
}

run_reboot() {
	shutdown_log "reboot_command=init"
	/sbin/reboot
	shutdown_log "reboot_init_returned=$?"
	# BusyBox normally asks PID 1 to restart the system and returns. Some Miyoo
	# firmware revisions instead finish shutdown without restarting. Storage is
	# already unmounted here, so use the direct kernel syscall if the system is
	# still running after a short handoff window.
	sleep 2
	shutdown_log "reboot_command=kernel"
	/sbin/reboot -f
	shutdown_log "reboot_kernel_returned=$?"
}

if [ "$0" = "/tmp/_shutdown" ]; then
	shutdown_mode=poweroff
	if [ -f /tmp/_shutdown.mode ]; then
		read -r shutdown_mode < /tmp/_shutdown.mode
	fi
	if [ -f /mnt/SDCARD/.bloom-dev ]; then
		SHUTDOWN_LOG_ENABLED=1
		: > /appconfigs/bloom-shutdown.log
	fi
	shutdown_log "shutdown_started=1"
	shutdown_log "shutdown_mode=$shutdown_mode"
	if [ "$shutdown_mode" = "reboot" ]; then
		# The Plus starts Bloom's charging UI whenever VBUS is present. Preserve
		# the caller's intent across reset so the next userspace boot can bypass
		# that UI once and continue to networking without a physical power press.
		mkdir -p /mnt/SDCARD/.bloom
		printf '%s\n' 1 > /mnt/SDCARD/.bloom/reboot-to-system
		shutdown_log "reboot_to_system_marker=1"
	fi

	killall -9 main # mandatory to avoid the suppression of .tmp_update !
	killall -9 updater
	killall -9 runtime.sh
	killall -9 smbd

	kill_hooked_tasks
	sleep 0.1
	kill_hooked_tasks -9

	sync

	if [ -f /mnt/SDCARD/system.json ]; then
		mkdir -p /mnt/SDCARD/.tmp_update/config/system
		mv -f /mnt/SDCARD/system.json "/mnt/SDCARD/.tmp_update/config/system/$(read_uuid).json"
		sync
	fi

	rm -f /appconfigs/system.json 2> /dev/null
	rm -f /mnt/SDCARD/update.log 2> /dev/null

	umount /etc/passwd /etc/group /etc/profile
	umount /mnt/SDCARD/miyoo/app/MainUI
	umount /mnt/SDCARD/RetroArch/retroarch
	umount /customer/lib/libgamename.so
	swapoff /mnt/SDCARD/cachefile
	shutdown_log "swapoff_complete=1"
	sync
	# Force FAT through a clean read-only transition before hardware poweroff.
	# This occurs only after settings and bind-mounted consumers are quiesced.
	remount_sd_read_only
	shutdown_log "remount_ro_final=$?"
	sync
	umount -r /mnt/SDCARD
	shutdown_log "umount_recursive=$?"
	umount /mnt/SDCARD
	shutdown_log "umount_final=$?"

	############# DEBUG #############
	# fuser -m /mnt/SDCARD > /appconfigs/shutdown.log
	# lsof /mnt/SDCARD >> /appconfigs/shutdown.log
	# mount >> /appconfigs/shutdown.log
	#################################

	if [ "$shutdown_mode" = "reboot" ]; then
		run_reboot
	else
		if [ "$(cat /tmp/deviceModel)" = "283" ]; then
			run_reboot # no poweroff command on Miyoo Mini
		else
			/sbin/poweroff
		fi
	fi

fi

if [ ! -f /tmp/_shutdown ]; then
	cp -f "$0" /tmp/_shutdown
fi

# run the script totally detached from current shell
pgrep -f /tmp/_shutdown || (
	set -m
	case "${1:-}" in
		-r) printf '%s\n' reboot > /tmp/_shutdown.mode ;;
		*) printf '%s\n' poweroff > /tmp/_shutdown.mode ;;
	esac
	/usr/bin/nohup /tmp/_shutdown </dev/null >/dev/null 2>&1 &
)
while true; do
	sleep 10
done
