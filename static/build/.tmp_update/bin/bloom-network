#!/bin/sh
set -eu

ROOT=${BLOOM_NETWORK_ROOT:-}
PLATFORM=${BLOOM_PLATFORM_BIN:-/mnt/SDCARD/.tmp_update/bin/bloom-platform}
JSONVAL=${BLOOM_NETWORK_JSONVAL_BIN:-/customer/app/jsonval}
LIB_DIR=${BLOOM_NETWORK_LIB_DIR:-$ROOT/mnt/SDCARD/.tmp_update/lib}
BACKEND=${BLOOM_NETWORK_BACKEND_BIN:-/mnt/SDCARD/.tmp_update/script/network/update_networking.sh}

result() {
    printf '{"schema":1,"service":"bloom-network","available":%s,"wifi_capable":%s,"wifi_enabled":%s,"associated":%s,"state":"%s"}\n' \
        "$1" "$2" "$3" "$4" "$5"
}

operation_result() {
    printf '{"schema":1,"service":"bloom-network","operation":"reconcile","applied":%s,"state":"%s"}\n' "$1" "$2"
}

wifi_capability() {
    [ -x "$PLATFORM" ] || return 1
    wifi=$($PLATFORM capability wifi 2>/dev/null) || return 1
    case "$wifi" in true|false) printf '%s' "$wifi" ;; *) return 1 ;; esac
}

status() {
    wifi=$(wifi_capability) || { result false false false false platform_unavailable; return 1; }
    case "$wifi" in
        false) result true false false false no_network_hardware; return 0 ;;
    esac

    [ -x "$JSONVAL" ] || { result false true false false wifi_state_unavailable; return 1; }
    enabled=$(LD_LIBRARY_PATH="/lib:/config/lib:/customer/lib:$LIB_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
        "$JSONVAL" wifi 2>/dev/null) || { result false true false false wifi_state_unavailable; return 1; }
    case "$enabled" in
        0) result true true false false wifi_disabled; return 0 ;;
        1) ;;
        *) result false true false false wifi_state_unavailable; return 1 ;;
    esac

    interface=$ROOT/sys/class/net/wlan0
    [ -d "$interface" ] || { result true true true false not_associated; return 0; }

    operstate=''
    carrier=''
    [ ! -r "$interface/operstate" ] || IFS= read -r operstate <"$interface/operstate" || true
    [ ! -r "$interface/carrier" ] || IFS= read -r carrier <"$interface/carrier" || true
    [ "$operstate" = up ] && [ "$carrier" = 1 ] || { result true true true false not_associated; return 0; }

    result true true true true associated
}

reconcile() {
    wifi=$(wifi_capability) || { operation_result false platform_unavailable; return 1; }
    if [ "$wifi" = false ]; then
        operation_result false no_network_hardware
        return 0
    fi
    [ -x "$BACKEND" ] || { operation_result false backend_unavailable; return 1; }
    "$BACKEND" check >/dev/null 2>&1 || { operation_result false backend_failed; return 1; }
    operation_result true applied
}

case "$#:${1:-}:${2:-}" in
    1:status:) status ;;
    2:request:reconcile) reconcile ;;
    *) result false false false false invalid_arguments; exit 2 ;;
esac
