#!/bin/sh
set -eu

ROOT=${BLOOM_NETWORK_ROOT:-}
PLATFORM=${BLOOM_PLATFORM_BIN:-/mnt/SDCARD/.tmp_update/bin/bloom-platform}
JSONVAL=${BLOOM_NETWORK_JSONVAL_BIN:-/customer/app/jsonval}
LIB_DIR=${BLOOM_NETWORK_LIB_DIR:-$ROOT/mnt/SDCARD/.tmp_update/lib}
BACKEND=${BLOOM_NETWORK_BACKEND_BIN:-/mnt/SDCARD/.tmp_update/bin/bloom-wifi}
COMPAT=${BLOOM_NETWORK_COMPAT_BIN:-/mnt/SDCARD/.tmp_update/script/network/update_networking.sh}
SETTINGS=${BLOOM_SETTINGS_BIN:-/mnt/SDCARD/.tmp_update/bin/bloom-settings}

result() {
    printf '{"schema":1,"service":"bloom-network","available":%s,"wifi_capable":%s,"wifi_enabled":%s,"associated":%s,"state":"%s"}\n' \
        "$1" "$2" "$3" "$4" "$5"
}

operation_result() {
    printf '{"schema":1,"service":"bloom-network","operation":"reconcile","applied":%s,"state":"%s"}\n' "$1" "$2"
}

preference_result() {
    printf '{"schema":1,"service":"bloom-network","operation":"%s","preference_saved":%s,"applied":%s,"state":"%s"}\n' \
        "$1" "$2" "$3" "$4"
}

wifi_capability() {
    [ -x "$PLATFORM" ] || return 1
    wifi=$($PLATFORM capability wifi 2>/dev/null) || return 1
    case "$wifi" in true|false) printf '%s' "$wifi" ;; *) return 1 ;; esac
}

status() {
    wifi=$(wifi_capability) || { result false false false false platform_unavailable; return 1; }
    case "$wifi" in
        false) result true false false false no_network_hardware; return 0 ;;
    esac

    [ -x "$JSONVAL" ] || { result false true false false wifi_state_unavailable; return 1; }
    enabled=$(LD_LIBRARY_PATH="/lib:/config/lib:/customer/lib:$LIB_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
        "$JSONVAL" wifi 2>/dev/null) || { result false true false false wifi_state_unavailable; return 1; }
    case "$enabled" in
        0) result true true false false wifi_disabled; return 0 ;;
        1) ;;
        *) result false true false false wifi_state_unavailable; return 1 ;;
    esac

    interface=$ROOT/sys/class/net/wlan0
    [ -d "$interface" ] || { result true true true false not_associated; return 0; }

    operstate=''
    carrier=''
    [ ! -r "$interface/operstate" ] || IFS= read -r operstate <"$interface/operstate" || true
    [ ! -r "$interface/carrier" ] || IFS= read -r carrier <"$interface/carrier" || true
    [ "$operstate" = up ] && [ "$carrier" = 1 ] || { result true true true false not_associated; return 0; }

    result true true true true associated
}

reconcile() {
    wifi=$(wifi_capability) || { operation_result false platform_unavailable; return 1; }
    if [ "$wifi" = false ]; then
        operation_result false no_network_hardware
        return 0
    fi
    [ -x "$BACKEND" ] || { operation_result false backend_unavailable; return 1; }
    if "$BACKEND" reconcile >/dev/null 2>&1; then
        [ ! -x "$COMPAT" ] || "$COMPAT" services >/dev/null 2>&1 || { operation_result false compatibility_failed; return 1; }
    else
        status=$?
        if [ "$status" -eq 3 ] && [ -x "$COMPAT" ] && "$COMPAT" check >/dev/null 2>&1; then
            operation_result true compatibility_applied
            return 0
        fi
        operation_result false backend_failed
        return 1
    fi
    operation_result true applied
}

set_preference() {
    operation=$1
    case "$operation" in
        enable) desired=true ;;
        disable) desired=false ;;
        *) preference_result "$operation" false false invalid_arguments; return 2 ;;
    esac
    wifi=$(wifi_capability) || { preference_result "$operation" false false platform_unavailable; return 1; }
    [ "$wifi" = true ] || { preference_result "$operation" false false no_network_hardware; return 1; }
    [ -x "$SETTINGS" ] || { preference_result "$operation" false false settings_unavailable; return 1; }
    "$SETTINGS" set device.wifi_enabled "$desired" >/dev/null 2>&1 || {
        preference_result "$operation" false false settings_rejected
        return 1
    }
    [ -x "$BACKEND" ] || { preference_result "$operation" true false backend_unavailable; return 1; }
    if "$BACKEND" reconcile >/dev/null 2>&1; then
        if [ -x "$COMPAT" ]; then
            "$COMPAT" services >/dev/null 2>&1 || {
                preference_result "$operation" true false compatibility_failed
                return 1
            }
        fi
    else
        status=$?
        if [ "$status" -ne 3 ] || [ ! -x "$COMPAT" ] || ! "$COMPAT" check >/dev/null 2>&1; then
            preference_result "$operation" true false backend_failed
            return 1
        fi
    fi
    preference_result "$operation" true true applied
}

case "$#:${1:-}:${2:-}" in
    1:status:) status ;;
    2:request:reconcile) reconcile ;;
    2:request:enable) set_preference enable ;;
    2:request:disable) set_preference disable ;;
    *) result false false false false invalid_arguments; exit 2 ;;
esac
