#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
TARGETS_FILE="${BLOOM_TARGETS_FILE:-$SCRIPT_DIR/targets.toml}"

usage() {
    cat <<'EOF'
Usage: bloom-device <info|smoke|collect|screenshot> <target> [output-directory]
       bloom-device game-smoke <target> <GB|GBC|GBA|FC|SFC|PSX|PICO> <rom-path> [seconds]

Targets are read from tools/targets.toml or BLOOM_TARGETS_FILE. Copy
targets.example.toml to create a local configuration. Connections require an
explicit SSH identity and strict host-key verification.
EOF
}

die() {
    printf 'bloom-device: %s\n' "$*" >&2
    exit 1
}

toml_value() {
    local target="$1" key="$2"
    awk -v section="[targets.$target]" -v wanted="$key" '
        { sub(/\r$/, "") }
        /^[[:space:]]*\[/ { active = ($0 == section); next }
        active && $0 ~ "^[[:space:]]*" wanted "[[:space:]]*=" {
            sub("^[[:space:]]*" wanted "[[:space:]]*=[[:space:]]*", "")
            sub(/[[:space:]]*#[^"]*$/, "")
            gsub(/^[[:space:]]+|[[:space:]]+$/, "")
            if ($0 ~ /^".*"$/) { sub(/^"/, ""); sub(/"$/, "") }
            print
            exit
        }
    ' "$TARGETS_FILE"
}

load_target() {
    local target="$1"
    [[ "$target" =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid target name: $target"
    [[ -f "$TARGETS_FILE" ]] || die "target file not found: $TARGETS_FILE"

    HOST="$(toml_value "$target" host)"
    USER_NAME="$(toml_value "$target" user)"
    PORT="$(toml_value "$target" port)"
    IDENTITY_FILE="$(toml_value "$target" identity_file)"
    EXPECTED_MODEL="$(toml_value "$target" expected_model)"
    KNOWN_HOSTS_FILE="$(toml_value "$target" known_hosts_file)"
    HOST_KEY_ALIAS="$(toml_value "$target" host_key_alias)"

    [[ -n "$HOST" && -n "$USER_NAME" && -n "$IDENTITY_FILE" && -n "$EXPECTED_MODEL" ]] ||
        die "target '$target' is missing a required setting"
    [[ "${PORT:-22}" =~ ^[0-9]+$ ]] || die "target '$target' has an invalid port"
    PORT="${PORT:-22}"
    [[ -f "$IDENTITY_FILE" ]] || die "identity file not found: $IDENTITY_FILE"
    [[ -z "$KNOWN_HOSTS_FILE" || -f "$KNOWN_HOSTS_FILE" ]] ||
        die "known_hosts file not found: $KNOWN_HOSTS_FILE"
    [[ "$HOST" =~ ^[A-Za-z0-9.:_-]+$ ]] || die "target '$target' has an invalid host"
    [[ "$USER_NAME" =~ ^[A-Za-z0-9._-]+$ ]] || die "target '$target' has an invalid user"
    [[ -z "$HOST_KEY_ALIAS" || "$HOST_KEY_ALIAS" =~ ^[A-Za-z0-9.:_-]+$ ]] ||
        die "target '$target' has an invalid host_key_alias"

    SSH_ARGS=(-o BatchMode=yes -o IdentitiesOnly=yes -o PreferredAuthentications=publickey
        -o PasswordAuthentication=no -o KbdInteractiveAuthentication=no
        -o StrictHostKeyChecking=yes -o ConnectTimeout=10
        -i "$IDENTITY_FILE" -p "$PORT")
    [[ -z "$KNOWN_HOSTS_FILE" ]] || SSH_ARGS+=(-o "UserKnownHostsFile=$KNOWN_HOSTS_FILE")
    [[ -z "$HOST_KEY_ALIAS" ]] || SSH_ARGS+=(-o "HostKeyAlias=$HOST_KEY_ALIAS")
    SSH_ARGS+=("$USER_NAME@$HOST")
}

remote_info() {
    ssh "${SSH_ARGS[@]}" '/mnt/SDCARD/.tmp_update/bin/bloomctl info --json'
}

verify_model() {
    local info="$1"
    printf '%s' "$info" | grep -Fq "\"model\": \"$EXPECTED_MODEL\"" ||
        die "device model does not match expected_model '$EXPECTED_MODEL'"
}

command_info() {
    local info
    info="$(remote_info)"
    verify_model "$info"
    printf '%s\n' "$info"
}

command_smoke() {
    local info
    info="$(remote_info)"
    verify_model "$info"
    ssh "${SSH_ARGS[@]}" 'test -d /mnt/SDCARD/.tmp_update && test -r /mnt/SDCARD/.tmp_update'
    printf 'PASS: identity and read-only SD-card checks (%s)\n' "$EXPECTED_MODEL"
}

command_collect() {
    local output_dir="$1" info
    mkdir -p -- "$output_dir"
    info="$(remote_info)"
    verify_model "$info"
    printf '%s\n' "$info" >"$output_dir/device.json"
    ssh "${SSH_ARGS[@]}" 'set +e
        echo "== uptime =="; uptime
        echo "== mounts =="; mount
        echo "== memory =="; cat /proc/meminfo
        echo "== kernel =="; dmesg
        echo "== bloom logs =="
        for f in /mnt/SDCARD/.tmp_update/logs/*.log /tmp/*.log; do
            test -f "$f" || continue
            echo "--- $f"; tail -n 500 "$f"
        done' >"$output_dir/runtime.log" 2>&1
    printf 'Diagnostics written to %s\n' "$output_dir"
}

command_screenshot() {
    local output_dir="$1" info display raw_b64
    mkdir -p -- "$output_dir"
    info="$(remote_info)"
    verify_model "$info"
    display="$(ssh "${SSH_ARGS[@]}" '/mnt/SDCARD/.tmp_update/bin/bloom-platform inspect --json')"
    raw_b64="$output_dir/framebuffer.b64"
    ssh "${SSH_ARGS[@]}" 'base64 /dev/fb0' >"$raw_b64"
    base64 -d "$raw_b64" >"$output_dir/framebuffer.raw"
    rm -f -- "$raw_b64"
    python3 - "$output_dir" "$display" <<'PY'
import hashlib
import json
import pathlib
import struct
import sys
import zlib

output = pathlib.Path(sys.argv[1])
display = json.loads(sys.argv[2])["display"]
width = int(display["width"])
height = int(display["height"])
virtual_width, virtual_height = map(int, display["virtual_size"].split(","))
if width <= 0 or height <= 0 or virtual_width != width or virtual_height % height:
    raise SystemExit("invalid framebuffer geometry")
pages = virtual_height // height
raw = (output / "framebuffer.raw").read_bytes()
page_size = width * height * 4
if pages <= 0 or len(raw) < pages * page_size:
    raise SystemExit("framebuffer capture is truncated")

def png_chunk(kind, payload):
    return struct.pack(">I", len(payload)) + kind + payload + struct.pack(">I", zlib.crc32(kind + payload))

hashes = []
for page_index in range(pages):
    page = raw[page_index * page_size:(page_index + 1) * page_size]
    hashes.append(hashlib.sha256(page).hexdigest())
    rows = []
    for y in range(height - 1, -1, -1):
        row = page[y * width * 4:(y + 1) * width * 4]
        pixels = bytearray()
        for x in range(width - 1, -1, -1):
            blue, green, red, _ = row[x * 4:x * 4 + 4]
            pixels.extend((red, green, blue))
        rows.append(b"\0" + bytes(pixels))
    header = struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)
    png = b"\x89PNG\r\n\x1a\n" + png_chunk(b"IHDR", header)
    png += png_chunk(b"IDAT", zlib.compress(b"".join(rows), 9)) + png_chunk(b"IEND", b"")
    (output / f"page-{page_index}-rotated.png").write_bytes(png)

metadata = {
    "schema": 1,
    "width": width,
    "height": height,
    "virtual_height": virtual_height,
    "pages": pages,
    "visible_bytes": pages * page_size,
    "padding_bytes": len(raw) - pages * page_size,
    "orientation_correction": "rotate_180",
    "page_sha256": hashes,
    "all_pages_equal": len(set(hashes)) == 1,
}
(output / "metadata.json").write_text(json.dumps(metadata, indent=2) + "\n", encoding="utf-8")
PY
    printf 'Framebuffer screenshot written to %s\n' "$output_dir"
}

command_game_smoke() {
    local system="$1" rom_path="$2" duration="$3" rom_b64
    [[ "$system" =~ ^(GB|GBC|GBA|FC|SFC|PSX|PICO)$ ]] || die "unsupported game-smoke system: $system"
    [[ "$duration" =~ ^[0-9]+$ ]] && ((duration >= 5 && duration <= 900)) ||
        die "game-smoke duration must be between 5 and 900 seconds"
    [[ "$rom_path" == /mnt/SDCARD/Roms/* ]] || die "game-smoke ROM must be under /mnt/SDCARD/Roms"
    [[ "$rom_path" != *$'\n'* && "$rom_path" != *$'\r'* ]] || die "game-smoke ROM path contains a newline"
    rom_b64="$(printf '%s' "$rom_path" | base64 | tr -d '\r\n')"
    ssh "${SSH_ARGS[@]}" "/mnt/SDCARD/.tmp_update/bin/bloom-game-smoke '$system' '$rom_b64' '$duration'"
}

[[ $# -ge 2 ]] || { usage >&2; exit 2; }
COMMAND="$1"
TARGET="$2"
load_target "$TARGET"

case "$COMMAND" in
    info) [[ $# -eq 2 ]] || die "info does not accept extra arguments"; command_info ;;
    smoke) [[ $# -eq 2 ]] || die "smoke does not accept extra arguments"; command_smoke ;;
    collect)
        [[ $# -le 3 ]] || die "collect accepts at most one output directory"
        command_collect "${3:-artifacts/device-logs/$TARGET-$(date -u +%Y%m%dT%H%M%SZ)}"
        ;;
    screenshot)
        [[ $# -le 3 ]] || die "screenshot accepts at most one output directory"
        command_screenshot "${3:-artifacts/device-screenshots/$TARGET-$(date -u +%Y%m%dT%H%M%SZ)}"
        ;;
    game-smoke)
        [[ $# -ge 4 && $# -le 5 ]] || die "game-smoke requires a system and ROM path, with optional duration"
        command_game_smoke "$3" "$4" "${5:-10}"
        ;;
    -h|--help|help) usage ;;
    *) usage >&2; exit 2 ;;
esac
